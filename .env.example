# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Database SSL configuration
DATABASE_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Express Session Hashing Secret
SESSION_SECRET=rits-jewellers-luxury-billing-secret-key-987654

# Application Port
PORT=8080

# Cookie Security Flags (Set to true in production over HTTPS)
COOKIE_SECURE=false

# Environment Mode
NODE_ENV=development
